[Unit]
Description=ISCC_CAR ROS 2 chassis driver
Documentation=file:///opt/eprobot_ws/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=dialout
Environment=ROS_DOMAIN_ID=0
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /opt/ros/lyrical/setup.bash && source /opt/eprobot_ws/install/setup.bash && exec ros2 launch eprobot_base_cpp base.launch.py'
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
# The driver sends STOP on SIGINT; SIGKILL would rely on the firmware's
# 400 ms link timeout instead.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
