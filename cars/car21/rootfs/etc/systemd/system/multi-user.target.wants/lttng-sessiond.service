[Unit]
Description=LTTng session daemon
Documentation=http://lttng.org/docs/#doc-lttng-sessiond

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/lttng-sessiond
ExecStart=/usr/bin/lttng-sessiond $DAEMON_ARGS
Restart=on-failure
KillMode=mixed

[Install]
WantedBy=multi-user.target
