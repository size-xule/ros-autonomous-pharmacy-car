[Unit]
Description=ISCC car Wi-Fi hotspot (wlan0 AP, SSID NDKY, 10.211.121.21)
After=systemd-networkd.service
Before=network.target
Wants=systemd-networkd.service

[Service]
Type=simple
ExecStartPre=/sbin/ip link set wlan0 down
ExecStartPre=-/sbin/ip addr flush dev wlan0
ExecStartPre=-/sbin/ip addr replace 10.211.121.21/24 dev wlan0
ExecStartPre=/sbin/ip link set wlan0 up
ExecStart=/usr/sbin/hostapd /etc/hostapd/iscc-ap.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
