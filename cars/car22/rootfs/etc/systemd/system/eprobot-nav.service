[Unit]
Description=EPRobot ROS 2 Nav2 navigation (AMCL + saved map, manual start)
Documentation=file:///home/keyuan22/eprobot_navigation/README.md
After=eprobot-base.service eprobot-imu.service lslidar.service
Wants=eprobot-base.service eprobot-imu.service lslidar.service
Conflicts=eprobot-slam.service

[Service]
# Fast DDS shared memory keeps one lock per participant; repeated restarts
# exhaust it ('Failed init_port fastdds_portXXXX') and then Nav2 action
# servers stop acknowledging goals.  UDP-only avoids the whole SHM path.
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
Type=simple
User=keyuan22
Group=keyuan22
Environment=ROS_DOMAIN_ID=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /opt/ros/lyrical/setup.bash && source /opt/eprobot_ws/install/setup.bash && exec ros2 launch /home/keyuan22/eprobot_navigation/launch/nav2_bringup.launch.py'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=no

[Install]
WantedBy=multi-user.target
