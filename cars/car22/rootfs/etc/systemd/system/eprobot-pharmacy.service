[Unit]
Description=EPRobot ROS 2 pharmacy providers (camera, QR/board-2, speech, judge)
Documentation=file:///opt/eprobot_ws/install/pharmacy_pkg/share/pharmacy_pkg/README.md
After=eprobot-base.service eprobot-imu.service
Wants=eprobot-base.service eprobot-imu.service

[Service]
# Fast DDS shared memory keeps one lock per participant; repeated restarts
# exhaust it ('Failed init_port fastdds_portXXXX') and then Nav2 action
# servers stop acknowledging goals.  UDP-only avoids the whole SHM path.
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
Type=simple
User=keyuan22
Group=keyuan22
SupplementaryGroups=video audio
Environment=ROS_DOMAIN_ID=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/keyuan22
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=JUDGE_CAR_ID=24
Environment=PHARMACY_IMAGE_TOPIC=/camera/rgb/image_raw
EnvironmentFile=-/etc/default/eprobot-pharmacy
ExecStartPre=-/usr/bin/amixer -c 0 sset PCM 100% unmute
ExecStart=/bin/bash -lc "source /opt/ros/lyrical/setup.bash && source /opt/eprobot_ws/install/setup.bash && exec ros2 launch pharmacy_pkg competition.launch.py start_camera:=false judge_car_id:=$JUDGE_CAR_ID image_topic:=$PHARMACY_IMAGE_TOPIC"
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=no

[Install]
WantedBy=multi-user.target
