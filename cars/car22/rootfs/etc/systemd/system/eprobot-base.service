[Unit]
Description=ISCC_CAR ROS 2 chassis driver
Documentation=file:///opt/eprobot_ws/README.md
After=network-online.target
Wants=network-online.target

[Service]
# Fast DDS shared memory keeps one lock per participant; repeated restarts
# exhaust it ('Failed init_port fastdds_portXXXX') and then Nav2 action
# servers stop acknowledging goals.  UDP-only avoids the whole SHM path.
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
Type=simple
User=keyuan22
Group=dialout
Environment=ROS_DOMAIN_ID=1
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /opt/ros/lyrical/setup.bash && source /opt/eprobot_ws/install/setup.bash && exec ros2 launch eprobot_base_cpp base.launch.py'
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
# The driver sends STOP on SIGINT; SIGKILL would rely on the firmware's
# 400 ms link timeout instead.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
