<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eprobot_base_cpp</name>
  <version>0.1.0</version>
  <description>
    C++ ROS 2 driver for the EPRobot chassis (STM32 lower board, wire protocol
    v2.1): Ackermann cmd_vel, odometry from the WHEELTEC H30 yaw, battery,
    diagnostics and STOP.
  </description>
  <maintainer email="iscc@ncut.edu.cn">ISCC_CAR Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
