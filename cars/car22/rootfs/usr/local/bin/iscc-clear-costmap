#!/usr/bin/env bash
# Clear Nav2 costmaps.  Domain is forced to 1: every unit on this car uses
# ROS_DOMAIN_ID=1, so the common "export ROS_DOMAIN_ID=0" recipe does nothing.
set +u
source /opt/ros/lyrical/setup.bash
source /opt/eprobot_ws/install/setup.bash 2>/dev/null || true
export ROS_DOMAIN_ID=1
export FASTDDS_BUILTIN_TRANSPORTS=UDPv4
exec python3 /home/keyuan22/iscc_clear_costmap.py "$@"
