#!/usr/bin/env bash
# ROS 2 graph dump.  Fast DDS discovers same-host peers over shared memory,
# which reports every endpoint as _NODE_NAME_UNKNOWN_, so force the UDP
# transport for this read-only probe (no effect on the running stack).
set +u
source /opt/ros/lyrical/setup.bash
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-1}"
export FASTDDS_BUILTIN_TRANSPORTS=UDPv4
exec python3 /home/keyuan22/iscc_ros_graph.py "$@"
